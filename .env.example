# L1 (synthetic, offline) — an LLM API key is required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# To use Kimi instead of OpenAI (cheaper for testing):
# OPENAI_API_KEY=your-kimi-key
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
# OPENAI_MODEL=kimi-k2.6

# L2 (real Slack + Google) — required only for --surface l2.
# Slack: https://api.slack.com/apps -> create app -> bot user with scopes:
#   channels:history channels:read groups:history im:history
#   users:read chat:write files:read
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=

# Google: OAuth client + refresh token via examples/python/google flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
