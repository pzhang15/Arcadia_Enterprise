{
  "documentId": "GD103",
  "title": "Platform Team Welcome",
  "body": {
    "content": [
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "# Welcome to the Platform Team\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "Author: Marcus Johnson (Eng Lead). Audience: new platform hires.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Who we are\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "Platform owns the multi-tenant data plane that ACME ships to customers. We're a team of 9 engineers + 1 EM + 1 PM.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## How we work\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Two-week sprints; planning Mondays, demo Fridays.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Code reviews within 24h SLA. Merge on green.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Postmortems are blameless and shared in /gdocs/owned/.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Your first week\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Pair with your buddy (Jordan Kim) on dev setup.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Shadow on-call without paging burden (Bob Lee is primary).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- First 1:1 with me (Marcus): pick a Thursday slot.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      }
    ]
  },
