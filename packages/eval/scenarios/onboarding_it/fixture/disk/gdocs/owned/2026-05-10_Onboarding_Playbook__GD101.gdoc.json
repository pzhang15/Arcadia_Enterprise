  "title": "Onboarding Playbook",
  "body": {
    "content": [
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "# NorthHill Onboarding Playbook\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "Owner: Diana Park (HR). Last updated: 2026-05-10.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Day 1\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Pick up laptop from IT desk (or arrange loaner if not yet shipped).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Sign into Okta (SSO triggers auto-provisioning of dependent apps).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- File any missing-access tickets via /tickets/queues/it-helpdesk/.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Read team welcome doc (manager shares).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Confirm buddy + first 1:1 with manager.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Day 2-5\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Complete security training (assigned via email).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Pair with buddy on dev environment setup.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Attend new-hire orientation (Wed 10am).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Week 2\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- First 1:1 with manager (themes: scope, growth, expectations).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Ship a small first PR (buddy reviews).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      }
    ]
  },
