{
  "documentId": "GD102",
  "title": "IT Runbook - New Hire Provisioning",
  "body": {
    "content": [
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "# IT Runbook: New Hire Provisioning\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "Owner: Sam Chen (IT Lead). Audience: IT support agents.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## SLA matrix (also see IT_SLA_Matrix doc)\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- P1 (blocker, e.g. SSO down for whole org): respond <15min, resolve <2h, escalate to IT Lead immediately.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- P2 (single-user blocker, e.g. new-hire SSO not working): respond <2h, resolve <8h.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- P3 (single-user non-blocker, e.g. AWS access for dev): respond <8h, resolve <48h. Escalate to IT Lead if open >48h.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- P4 (cosmetic / preference): best-effort, target <1wk.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Provisioning checklist (per role)\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Look up the role row in Access Matrix (sheet SH103).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- For each access listed: file a separate ticket (one per system).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "  Reuse existing tickets if a near-duplicate is open.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- For GitHub access: invite to org listed in Access Matrix; send email confirmation; close ticket only after acceptance.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- For AWS access: provision IAM role per role row; tag with team + start date; verify SSO works.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- For Slack workspace access: ensure Okta SSO group includes the user; do NOT manually add (Okta handles it).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "## Equipment workflow\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- If laptop has not arrived by Day 1: assign loaner from MBP-LOAN-* pool. Update Equipment Inventory (sheet SH102).\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      },
      {
        "paragraph": {
          "elements": [
            {
              "textRun": {
                "content": "- Real device, on arrival: swap, return loaner.\n",
                "textStyle": {}
              }
            }
          ],
          "paragraphStyle": {}
        }
      }
    ]
  },
  "documentStyle": {},
  "namedStyles": {},
